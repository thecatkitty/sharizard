#include <windows.h>

#include <sharizard/winres.h>

SHIZ_WINRES_IDD_TEMPLATE DIALOGEX 0, 0, 294, 154
STYLE DS_SETFONT | WS_CHILD | WS_VISIBLE | DS_CONTROL
LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
FONT 8, "MS Shell Dlg 2"
{
   CONTROL "TEXT", SHIZ_WINRES_IDC_TEXT, "STATIC", WS_CHILD | WS_VISIBLE | SS_LEFT, 0, 0, 252, 60 
   CONTROL "", SHIZ_WINRES_IDC_EDITBOX, "EDIT", WS_CHILD | WS_VISIBLE | WS_BORDER | WS_TABSTOP | ES_AUTOHSCROLL | ES_UPPERCASE, 0, 70, 200, 14 
   CONTROL "ALERT", SHIZ_WINRES_IDC_ALERT, "STATIC", WS_CHILD | WS_VISIBLE | SS_LEFT, 12, 90, 240, 14
   CONTROL "BANG", SHIZ_WINRES_IDC_BANG, "STATIC", WS_CHILD | WS_VISIBLE | SS_ICON, 0, 89, 12, 10 
   CONTROL "CHECK", SHIZ_WINRES_IDC_CHECK, "BUTTON", WS_CHILD | WS_VISIBLE | WS_TABSTOP | BS_AUTOCHECKBOX, 0, 140, 252, 14
}

SHIZ_WINRES_IDD_VACAT DIALOGEX 0, 0, 1, 1
STYLE DS_SETFONT | WS_CHILD | WS_VISIBLE | DS_CONTROL
LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
FONT 8, "MS Shell Dlg 2"
{
}

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
SHIZ_WINRES_IDB_HEADER BITMAP "header.bmp"
